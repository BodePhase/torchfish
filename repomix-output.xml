import { useState, useEffect, useRef } from 'react';
import { Chessboard } from 'react-chessboard';
import { Chess } from 'chess.js';
import './App.css';

const calculateMaterial = (chessInstance) => {
  const startingPieces = { p: 8, n: 2, b: 2, r: 2, q: 1 };
  const currentPieces = { w: { p: 0, n: 0, b: 0, r: 0, q: 0 }, b: { p: 0, n: 0, b: 0, r: 0, q: 0 } };
  const values = { p: 1, n: 3, b: 3, r: 5, q: 9 };
  const pieceSymbols = {
    w: { p: '♙', n: '♘', b: '♗', r: '♖', q: '♕' },
    b: { p: '♟', n: '♞', b: '♝', r: '♜', q: '♛' }
  };

  chessInstance.board().forEach(row => {
    row.forEach(piece => {
      if (piece) currentPieces[piece.color][piece.type]++;
    });
  });

  const getCaptured = (color) => {
    let captured = [];
    let score = 0;
    for (let type in startingPieces) {
      const diff = startingPieces[type] - currentPieces[color][type];
      for (let i = 0; i < diff; i++) {
        captured.push(pieceSymbols[color][type]);
        score += values[type];
      }
    }
    return { captured, score };
  };

  const white = getCaptured('w');
  const black = getCaptured('b');
  
  return {
    whiteCaptured: white.captured, 
    blackCaptured: black.captured, 
    whiteAdvantage: white.score < black.score ? black.score - white.score : 0,
    blackAdvantage: black.score < white.score ? white.score - black.score : 0,
  };
};

const formatMoveToFigurine = (san) => {
  if (!san) return '';
  return san.replace(/N/g, '♘')
            .replace(/B/g, '♗')
            .replace(/R/g, '♖')
            .replace(/Q/g, '♕')
            .replace(/K/g, '♔');
};

export default function App() {
  const [game, setGame] = useState(new Chess());
  const [kasparovThinking, setKasparovThinking] = useState(false);
  const [moveFrom, setMoveFrom] = useState(null);
  const [rightClickedSquares, setRightClickedSquares] = useState({});
  const [material, setMaterial] = useState({ whiteCaptured: [], blackCaptured: [], whiteAdvantage: 0, blackAdvantage: 0 });
  
  const moveListRef = useRef(null);

  useEffect(() => {
    setMaterial(calculateMaterial(game));
    if (moveListRef.current) {
      moveListRef.current.scrollTop = moveListRef.current.scrollHeight;
    }
  }, [game.fen()]);

  // NUOVO: Colora subito la casella quando inizi a trascinare il pezzo
  function onPieceDragBegin(piece, sourceSquare) {
    if (kasparovThinking) return;
    
    // Se il pezzo è bianco, evidenzia subito la casella
    if (piece.charAt(0) === 'w') {
      setMoveFrom(sourceSquare);
    }
    setRightClickedSquares({}); // Pulisce i rossi se inizi a trascinare
  }

  function onDrop(sourceSquare, targetSquare) {
    if (kasparovThinking) return false;
    
    setRightClickedSquares({}); 
    
    const gameCopy = new Chess();
    gameCopy.loadPgn(game.pgn());

    try {
      const move = gameCopy.move({ from: sourceSquare, to: targetSquare, promotion: 'q' });
      
      // Se la mossa non è valida o il pezzo torna indietro, spegni il giallo
      if (!move) {
        setMoveFrom(null);
        return false;
      }
      
      setGame(gameCopy);
      setMoveFrom(null);
      setTimeout(() => makeAIMove(gameCopy.fen()), 50);
      return true;
    } catch (e) {
      setMoveFrom(null);
      return false;
    }
  }

  function onSquareClick(square) {
    if (kasparovThinking) return;
    
    setRightClickedSquares({}); 
    
    if (!moveFrom) {
      const hasPiece = game.get(square);
      if (hasPiece && hasPiece.color === 'w') setMoveFrom(square);
      return;
    }
    const gameCopy = new Chess();
    gameCopy.loadPgn(game.pgn());
    try {
      const move = gameCopy.move({ from: moveFrom, to: square, promotion: 'q' });
      if (move) {
        setGame(gameCopy);
        setMoveFrom(null);
        setTimeout(() => makeAIMove(gameCopy.fen()), 50);
      } else {
        const hasPiece = game.get(square);
        if (hasPiece && hasPiece.color === 'w') setMoveFrom(square);
        else setMoveFrom(null);
      }
    } catch (e) {
      setMoveFrom(null);
    }
  }

  function onSquareRightClick(square) {
    setRightClickedSquares((prev) => {
      const newSquares = { ...prev };
      if (newSquares[square]) {
        delete newSquares[square];
      } else {
        newSquares[square] = { backgroundColor: 'rgba(235, 97, 80, 0.8)' };
      }
      return newSquares;
    });
  }

  async function makeAIMove(currentFen) {
    setKasparovThinking(true);
    try {
      const response = await fetch("http://localhost:8000/api/evaluate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ fen: currentFen })
      });
      const data = await response.json();
      await new Promise(r => setTimeout(r, 600)); 
      
      if (data.best_move_san) {
        setGame((currentGame) => {
          const aiGameCopy = new Chess();
          aiGameCopy.loadPgn(currentGame.pgn());
          aiGameCopy.move(data.best_move_san);
          return aiGameCopy;
        });
      }
    } catch (error) {
      console.error("Errore API:", error);
    } finally {
      setKasparovThinking(false);
    }
  }

  const historyVerbose = game.history({ verbose: true });
  const movePairs = [];
  for (let i = 0; i < historyVerbose.length; i += 2) {
    movePairs.push([historyVerbose[i], historyVerbose[i + 1]]);
  }

  const lastMove = historyVerbose.length > 0 ? historyVerbose[historyVerbose.length - 1] : null;
  
  let customStyles = {};
  
  if (lastMove) {
    customStyles[lastMove.from] = { backgroundColor: 'rgba(255, 255, 51, 0.5)' };
    customStyles[lastMove.to] = { backgroundColor: 'rgba(255, 255, 51, 0.5)' };
  }
  
  if (moveFrom) {
    customStyles[moveFrom] = { backgroundColor: 'rgba(255, 255, 51, 0.5)' };
  }
  
  Object.keys(rightClickedSquares).forEach(square => {
    customStyles[square] = rightClickedSquares[square];
  });

  return (
    <div className="lichess-container">
      <div className="board-column">
        <div className="player-info">
          <span>{kasparovThinking ? '🧠 Kasparov sta riflettendo...' : '🤖 TorchFish (Kasparov)'}</span>
          <div className="captured-pieces">
            {material.whiteCaptured.map((p, i) => <span key={`w-${i}`}>{p}</span>)} 
            {material.blackAdvantage > 0 && <span className="advantage">+{material.blackAdvantage}</span>}
          </div>
        </div>

        <div className="board-container" onContextMenu={(e) => e.preventDefault()}>
          <Chessboard 
            position={game.fen()} 
            onPieceDrop={onDrop} 
            onSquareClick={onSquareClick}
            onSquareRightClick={onSquareRightClick}
            onPieceDragBegin={onPieceDragBegin} // Aggiunto il listener del trascinamento
            boardOrientation="white" 
            customSquareStyles={customStyles}
            showBoardNotation={true}
          />
        </div>

        <div className="player-info">
          <span>👤 Tu</span>
          <div className="captured-pieces">
            {material.blackCaptured.map((p, i) => <span key={`b-${i}`}>{p}</span>)}
            {material.whiteAdvantage > 0 && <span className="advantage">+{material.whiteAdvantage}</span>}
          </div>
        </div>
      </div>

      <div className="sidebar-column">
        <div className="sidebar-header">
          Cronologia Mosse
        </div>
        <div className="move-list" ref={moveListRef}>
          {movePairs.map((pair, index) => {
            const isWhiteActive = historyVerbose.length === (index * 2) + 1;
            const isBlackActive = historyVerbose.length === (index * 2) + 2;

            return (
              <div key={index} className="move-row">
                <span className="move-number">{index + 1}</span>
                <span className={`move-cell ${isWhiteActive ? 'active-move' : ''}`}>
                  {formatMoveToFigurine(pair[0].san)}
                </span>
                <span className={`move-cell ${isBlackActive ? 'active-move' : ''}`}>
                  {pair[1] ? formatMoveToFigurine(pair[1].san) : ''}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
