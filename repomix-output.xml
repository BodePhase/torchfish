/* App.css - Stile clone Lichess per TorchFish */

.lichess-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: stretch;
  gap: 20px;
  padding: 20px;
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
  box-sizing: border-box;
  font-family: "Noto Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #bababa;
}

/* --- COLONNA SCACCHIERA --- */
.board-column {
  flex: 1;
  width: 100%;
  max-width: 80vh; 
  min-width: 320px;
  display: flex;
  flex-direction: column;
}

.player-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 4px;
  font-size: 1.05rem;
  color: #ffffff;
}

.captured-pieces {
  display: flex;
  align-items: center;
  font-size: 1.4rem;
  color: #8b8987;
  font-family: "Segoe UI Symbol", "Apple Color Emoji", "Arial Unicode MS", sans-serif;
}

.advantage {
  color: #629924; /* Verde Lichess per il vantaggio */
  font-size: 0.9rem;
  font-weight: bold;
  margin-left: 8px;
  font-family: monospace;
}

.board-container {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 3px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

/* --- COLONNA LATERALE (CRONOLOGIA MOSSE) --- */
.sidebar-column {
  width: 350px;
  flex-shrink: 0;
  background-color: #262421;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  max-height: calc(80vh + 80px);
}

.sidebar-header {
  padding: 12px 16px;
  background-color: #1e1d1a;
  border-bottom: 1px solid #302e2c;
  font-weight: 600;
  color: #dbd7d2;
  font-size: 0.95rem;
  text-align: left;
}

.move-list {
  flex: 1;
  overflow-y: auto;
  padding: 0;
  margin: 0;
  font-size: 0.95rem;
  font-family: "Noto Sans", sans-serif;
}

.move-row {
  display: flex;
  padding: 0;
  align-items: stretch;
}

.move-row:nth-child(even) {
  background-color: #302e2c;
}
.move-row:nth-child(odd) {
  background-color: #262421;
}

.move-number {
  width: 40px;
  padding: 6px 0 6px 16px;
  color: #7b7875;
  background-color: #262421;
}

.move-cell {
  flex: 1;
  padding: 6px 12px;
  cursor: pointer;
  color: #dbd7d2;
  font-family: "Segoe UI Symbol", "Apple Color Emoji", sans-serif; /* Supporto figurine */
}

.move-cell:hover:not(.active-move) {
  background-color: #383634;
}

/* Colore blu per l'ultima mossa giocata */
.active-move {
  background-color: #206ea7;
  color: #ffffff;
  font-weight: bold;
}

/* Scrollbar */
.move-list::-webkit-scrollbar {
  width: 8px;
}
.move-list::-webkit-scrollbar-track {
  background: #1e1c19;
}
.move-list::-webkit-scrollbar-thumb {
  background: #4a4846;
  border-radius: 4px;
}
.move-list::-webkit-scrollbar-thumb:hover {
  background: #6b6967;
}

/* --- RESPONSIVITÀ (Tablet e Smartphone) --- */
@media (max-width: 950px) {
  .lichess-container {
    flex-direction: column;
    align-items: center;
    padding: 10px;
    gap: 15px;
  }
  .board-column {
    width: 100%;
    max-width: 100%;
    /* Rimuovi il vincolo vh per permettere lo scorrimento nativo */
  }
  .sidebar-column {
    width: 100%;
    max-width: 100%;
    height: 250px; /* Altezza fissa su mobile per non allungare troppo la pagina */
  }
}

/* --- GESTIONE PRESA STILE CHESS.COM (Nessun ingrandimento) --- */

/* Manina aperta quando passi il mouse sopra a un pezzo */
[data-piece] {
  cursor: -webkit-grab !important;
  cursor: grab !important;
}

/* Manina chiusa nel punto esatto del clic, senza alterare le dimensioni o la posizione */
[data-piece]:active {
  cursor: -webkit-grabbing !important;
  cursor: grabbing !important;
}
