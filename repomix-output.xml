from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import chess

# Importiamo la nuova classe
from inference import KasparovEngine 

app = FastAPI(title="TorchFish Kasparov API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], 
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Inizializza il motore di Kasparov
print("Caricamento Cervello Kasparov in corso...")
engine = KasparovEngine(weights_path="weights/kasparov_policy.pth")
print("Modello Kasparov caricato con successo!")

class FenRequest(BaseModel):
    fen: str

@app.post("/api/evaluate")
async def evaluate_position(request: FenRequest):
    try:
        board = chess.Board(request.fen)
    except ValueError:
        raise HTTPException(status_code=400, detail="Stringa FEN non valida")

    # Kasparov restituisce la mossa e la percentuale di sicurezza
    best_move, confidence = engine.get_best_move(request.fen)
    
    return {
        "fen": request.fen,
        # Usiamo i campi esistenti per non rompere React: 
        # Mostriamo la % di confidenza al posto dei centipawns!
        "normalized_score": round(confidence / 100, 4), 
        "centipawns": round(confidence, 1), 
        "best_move_uci": best_move.uci() if best_move else None,
        "best_move_san": board.san(best_move) if best_move else None,
        "turn": "white" if board.turn == chess.WHITE else "black"
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
