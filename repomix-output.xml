<file path="inference.py">
import torch
import chess
import json
import numpy as np
from model import ChessValueNetwork
from dataset import ChessEvaluationDataset
from models.policy_net import KasparovPolicyNet

class ChessEngine:
    def __init__(self, model_path):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        # Deve corrispondere all'architettura salvata nel train.py
        self.model = ChessValueNetwork(num_blocks=6, num_channels=256)
        self.model.load_state_dict(torch.load(model_path, map_location=self.device, weights_only=True))
        self.model.to(self.device)
        self.model.eval()
        self.dataset_helper = ChessEvaluationDataset("dummy.csv") # Solo per riutilizzare board_to_tensor

    def evaluate_fen(self, fen):
        board = chess.Board(fen)
        tensor = self.dataset_helper.board_to_tensor(board).unsqueeze(0).to(self.device)
        
        with torch.no_grad():
            normalized_score = self.model(tensor).item()
            
        # Invertiamo la normalizzazione tanh(score/400) per riottenere un valore approssimativo in centipedoni
        # np.arctanh fuziona nel range (-1, 1). Aggiungiamo clip per stabilità numerica
        clipped_score = np.clip(normalized_score, -0.999, 0.999)
        centipawns = np.arctanh(clipped_score) * 400.0
        
        return normalized_score, centipawns

    def get_best_move(self, fen):
        """Ricerca statica a profondità 1 (1-ply)"""
        board = chess.Board(fen)
        best_move = None
        
        # Se tocca al bianco cerchiamo il punteggio massimo, se al nero il punteggio minimo
        best_score = -float('inf') if board.turn == chess.WHITE else float('inf')
        
        for move in board.legal_moves:
            board.push(move)
            # Valutiamo la posizione risultante
            norm_score, _ = self.evaluate_fen(board.fen())
            board.pop()
            
            if board.turn == chess.WHITE:
                if norm_score > best_score:
                    best_score = norm_score
                    best_move = move
            else:
                if norm_score < best_score:
                    best_score = norm_score
                    best_move = move
                    
        return best_move, best_score

if __name__ == "__main__":
    engine = ChessEngine("best_chess_model.pth")
    test_fen = "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w KQkq - 2 3" # Ruy Lopez
    
    norm_sc, cp = engine.evaluate_fen(test_fen)
    print(f"Valutazione statica FEN: {norm_sc:.4f} (Circa {cp:.1f} centipedoni)")
    
    best_move, move_score = engine.get_best_move(test_fen)
    print(f"Migliore mossa stimata (depth 1): {best_move} con punteggio {move_score:.4f}")


class KasparovEngine:
    def __init__(self, weights_path="weights/kasparov_policy.pth", dict_path="models/uci_dictionary.json"):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        
        # Inizializza l'architettura a 4544 uscite
        self.model = KasparovPolicyNet(num_classes=4544).to(self.device)
        self.model.load_state_dict(torch.load(weights_path, map_location=self.device, weights_only=True))
        self.model.eval() # Modalità inferenza (spegne i gradienti)

        # Carica il dizionario per la conversione inversa (da Indice a Stringa UCI)
        with open(dict_path, "r") as f:
            vocabs = json.load(f)
            # Il JSON salva le chiavi numeriche come stringhe ("0": "a1a2"), le riconvertiamo in interi
            self.int_to_move = {int(k): v for k, v in vocabs["int_to_move"].items()}

        # La solita mappatura
        self.piece_to_channel = {
            chess.PAWN: 0, chess.KNIGHT: 1, chess.BISHOP: 2,
            chess.ROOK: 3, chess.QUEEN: 4, chess.KING: 5
        }

    def board_to_tensor(self, board):
        tensor = torch.zeros((14, 8, 8), dtype=torch.float32)
        for square in chess.SQUARES:
            piece = board.piece_at(square)
            if piece:
                channel = self.piece_to_channel[piece.piece_type]
                if not piece.color: channel += 6
                row = chess.square_rank(square)
                col = chess.square_file(square)
                tensor[channel, row, col] = 1.0
        if board.turn == chess.WHITE:
            tensor[12, :, :] = 1.0
        return tensor

    def get_best_move(self, fen):
        board = chess.Board(fen)
        tensor = self.board_to_tensor(board).unsqueeze(0).to(self.device)

        # Ottieni le probabilità (Softmax) per tutte le 4544 mosse
        probs = self.model.predict_probabilities(tensor)[0]

        # Ordina gli indici dalla mossa con probabilità più alta alla più bassa
        sorted_indices = torch.argsort(probs, descending=True)

        # Cerca la prima mossa legale
        for idx in sorted_indices:
            move_uci = self.int_to_move[idx.item()]
            move = chess.Move.from_uci(move_uci)
            
            # Se la mossa preferita da Kasparov è legale sulla scacchiera reale, giocala!
            if move in board.legal_moves:
                confidence = probs[idx].item() * 100 # In percentuale
                return move, confidence

        return None, 0.0 # Se fallisce catastroficamente
